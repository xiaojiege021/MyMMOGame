<?xml version="1.0" encoding="utf-8"?>
<!--
  热更程序集在 IL2CPP 剥离之后才加载，剥离器看不到它对引擎类型的引用。
  这里显式保留热更代码会用到的引擎类型，避免打包后被剥掉。
-->
<linker>
  <!-- 热更侧要连战斗进程、要建界面，这几个程序集对剥离器来说是「没人引用」。 -->
  <assembly fullname="Mmo.Net" preserve="all" />
  <assembly fullname="Mmo.Proto" preserve="all" />
  <assembly fullname="UnityEngine.UIModule" preserve="all" />
  <assembly fullname="UnityEngine.TextRenderingModule" preserve="all" />
  <assembly fullname="UnityEngine.UI" preserve="all" />
  <assembly fullname="UnityEngine.InputSystem" preserve="all" />
  <assembly fullname="UnityEngine.PhysicsModule" preserve="all" />
  <assembly fullname="UnityEngine.CoreModule">
    <type fullname="UnityEngine.Collider" preserve="all" />
    <type fullname="UnityEngine.BoxCollider" preserve="all" />
    <type fullname="UnityEngine.MeshCollider" preserve="all" />
    <type fullname="UnityEngine.RaycastHit" preserve="all" />
  </assembly>
</linker>
