  "entries": [
    {
      "key": "T001",
      "text": "主线"
    },
    {
      "key": "T002",
      "text": "仅 1 人 · 不扣疲劳 · 不占周份额 · 教学与系统解锁"
    },
    {
      "key": "T003",
      "text": "1 人"
    },
    {
      "key": "T004",
      "text": "深渊"
    },
    {
      "key": "T005",
      "text": "1–4 人 · 疲劳按人数倍增 · 日上限 6000"
    },
    {
      "key": "T006",
      "text": "当前"
    },
    {
      "key": "T007",
      "text": "巢穴"
    },
    {
      "key": "T008",
      "text": "1–4 人 · 不扣疲劳 · 占周份额 · 每周 12 个单人份"
    },
    {
      "key": "T009",
      "text": "高级"
    },
    {
      "key": "T010",
      "text": "龙巢 / 世界 Boss / 宗门秘境"
    },
    {
      "key": "T011",
      "text": "这三类在副本表里还没有，等后续卡，本屏不列、不编数"
    },
    {
      "key": "T012",
      "text": "副本实例 · 深渊"
    },
    {
      "key": "T013",
      "text": "服务器按一次技能结算一次"
    },
    {
      "key": "T014",
      "text": "选中目标后技能才发得出去"
    },
    {
      "key": "T015",
      "text": "伤害由回包写入，本地不预估"
    },
    {
      "key": "T016",
      "text": "前摇期间可以走位，命中前可打断"
    },
    {
      "key": "T017",
      "text": "切换目标"
    },
    {
      "key": "T018",
      "text": "小队"
    },
    {
      "key": "T019",
      "text": "复活卷轴"
    },
    {
      "key": "T020",
      "text": "离开副本"
    },
    {
      "key": "T021",
      "text": "同一笔 SettleExp；≥2 人同场多一截，不叠加"
    },
    {
      "key": "T022",
      "text": "掉落以角色服背包回包为准，本地不造物品"
    },
    {
      "key": "T023",
      "text": "疲劳按人数倍增 · 日上限 6000 · 巢穴占周份额"
    },
    {
      "key": "T024",
      "text": "基础：副本 / 任务 / 竞技场 / 战场 / 城战 / 世界 Boss 结算"
    },
    {
      "key": "T025",
      "text": "组队：同一场 ≥2 人，每人少量加成"
    },
    {
      "key": "T026",
      "text": "同门：其中 ≥2 人同宗门再多一截（本版未做）"
    },
    {
      "key": "T027",
      "text": "只加等级经验：不加伤害、不加掉落、不加疲劳、不加副本次数"
    },
    {
      "key": "T028",
      "text": "战斗日志"
    },
    {
      "key": "T029",
      "text": "坦克"
    },
    {
      "key": "T030",
      "text": "战士"
    },
    {
      "key": "T031",
      "text": "法师"
    },
    {
      "key": "T032",
      "text": "射手"
    },
    {
      "key": "T033",
      "text": "牧师"
    },
    {
      "key": "T034",
      "text": "未知"
    },
    {
      "key": "T035",
      "text": "阶段 "
    },
    {
      "key": "T036",
      "text": " · 读招与前摇由服务端给"
    },
    {
      "key": "T037",
      "text": "疲劳不够，今天进不去了"
    },
    {
      "key": "T038",
      "text": "本周份额用完了"
    },
    {
      "key": "T039",
      "text": "人数和战斗服对不上"
    },
    {
      "key": "T040",
      "text": "人数超过这张副本的上限"
    },
    {
      "key": "T041",
      "text": "等级不够"
    },
    {
      "key": "T042",
      "text": "境界没到"
    },
    {
      "key": "T043",
      "text": "这张副本还没有开放"
    },
    {
      "key": "T044",
      "text": "服务端拒绝了这次进本"
    }
  ]
}
