{
  "schema": "ui-text/1",
  "group": "UiSocialCodex",
  "source": "client/MMOGame/Assets/HotUpdate/Ui/UiSocialCodex.cs",
  "entries": [
    {
      "key": "T001",
      "text": "1 级 · 初建"
    },
    {
      "key": "T002",
      "text": "2 级 · 开始能分工"
    },
    {
      "key": "T003",
      "text": "3 级 · 中型宗门"
    },
    {
      "key": "T004",
      "text": "4 级 · 大型宗门"
    },
    {
      "key": "T005",
      "text": "5 级 · 顶级"
    },
    {
      "key": "T006",
      "text": "掌门"
    },
    {
      "key": "T007",
      "text": "副掌门"
    },
    {
      "key": "T008",
      "text": "长老"
    },
    {
      "key": "T009",
      "text": "执事"
    },
    {
      "key": "T010",
      "text": "其余弟子"
    },
    {
      "key": "T011",
      "text": "贡献：宗门秘境与宗门任务来，不从商城买"
    },
    {
      "key": "T012",
      "text": "建设：创建耗金币，升级耗建设，商城不卖"
    },
    {
      "key": "T013",
      "text": "科技：只在城战生效，不给日常副本加伤害"
    },
    {
      "key": "T014",
      "text": "只卖基础药品和辅助物品，不卖材料：矿、药、灵石、强化石、结晶、胚子、装备都不卖。"
    },
    {
      "key": "T015",
      "text": "名册上限与席位数字只从 /sect/* 回包读 · 客户端不写死 · 拒绝一律 ok=false + reason"
    },
    {
      "key": "T016",
      "text": "竞技场 1v1 / 3v3"
    },
    {
      "key": "T017",
      "text": "属性模板统一，只留职业与分支"
    },
    {
      "key": "T018",
      "text": "战场 10v10"
    },
    {
      "key": "T019",
      "text": "装备生效，同队战力由战斗服压缩"
    },
    {
      "key": "T020",
      "text": "城战 / 领地"
    },
    {
      "key": "T021",
      "text": "装备全额生效，再加宗门科技"
    },
    {
      "key": "T022",
      "text": "同屏规格只按战斗服下发的档位：完整的画完整模型，超限的只留队伍颜色和血条，不按距离自己判。"
    },
    {
      "key": "T023",
      "text": "领地归属只记名字：不加属性、不改税收、不把灵石矿脉转走。个人采集照样采不到灵石。"
    },
    {
      "key": "T024",
      "text": "伤害最高的宗门在下一场刷新前把名字记在入口上；没有宗门的人也能进，也能拿个人奖励。"
    },
    {
      "key": "T025",
      "text": "本场数值只来自战斗服回包 · 界面不算战力、不乘平衡系数、不读配置"
    },
    {
      "key": "T026",
      "text": "进场只认 /versus/* 回包：路径、模式人数、场次与队伍照抄；不本地算战力、不做匹配算法"
    },
    {
      "key": "T027",
      "text": "竞技奖励偏外观与荣誉，不给战力材料；长线养成在城战兑现，两套目标分开。"
    },
    {
      "key": "T028",
      "text": "生活技能"
    },
    {
      "key": "T029",
      "text": "挖矿产矿石给铁匠，采药产药材给炼丹师；谁都能学、可同时学、不耗疲劳"
    },
    {
      "key": "T030",
      "text": "城镇 NPC"
    },
    {
      "key": "T031",
      "text": "卖镐、药锄和基础背包；宗门 NPC 只卖基础药品和辅助物品"
    },
    {
      "key": "T032",
      "text": "家园 / 洞府"
    },
    {
      "key": "T033",
      "text": "种植产家园币，只换外观和便捷；摆件与装饰只做展示，不进伤害公式"
    },
    {
      "key": "T034",
      "text": "时间结构"
    },
    {
      "key": "T035",
      "text": "大世界、挖矿、采药、家园、钓鱼、外观收集不设日限周限"
    },
    {
      "key": "T036",
      "text": "摆件只做展示；家园币不换金币、材料、副本次数或任何战力。"
    },
    {
      "key": "T037",
      "text": "种植与家园币只认回包：产量、成熟、这次扣多少与余额都不在客户端算"
    },
    {
      "key": "T038",
      "text": "收集度与被动只做收集、外观和生活协助，不进入伤害公式；灵兽同理。"
    },
    {
      "key": "T039",
      "text": "第二角色栏开启后，装备、等级、境界不共享，外观收藏可以共享。"
    },
    {
      "key": "T040",
      "text": "九格只认 /hero-codex 回包：名字、收集度、被动 bps 都照抄；未定的格子留空，不补编条目"
    },
    {
      "key": "T041",
      "text": "云锦"
    }
  ]
}
