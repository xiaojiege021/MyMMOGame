{
  "schema": "ui-text/1",
  "group": "UiEntryCodex",
  "source": "client/MMOGame/Assets/HotUpdate/Ui/UiEntryCodex.cs",
  "entries": [
    {
      "key": "T001",
      "text": "仙路已断"
    },
    {
      "key": "T002",
      "text": "长生隙"
    },
    {
      "key": "T003",
      "text": "表里两界之间那道缝"
    },
    {
      "key": "T004",
      "text": "云锦"
    },
    {
      "key": "T005",
      "text": "听谣镇旧谣"
    },
    {
      "key": "T006",
      "text": "仙路尽头谁为峰"
    },
    {
      "key": "T007",
      "text": "一见隙开道成空"
    },
    {
      "key": "T008",
      "text": "尘民"
    },
    {
      "key": "T009",
      "text": "灵气稀薄之后最常见的凡人"
    },
    {
      "key": "T010",
      "text": "脉裔"
    },
    {
      "key": "T011",
      "text": "住在还没干涸的灵脉旁边"
    },
    {
      "key": "T012",
      "text": "岚民"
    },
    {
      "key": "T013",
      "text": "从前走高空航路的人，航路断了以后住在崖上"
    },
    {
      "key": "T014",
      "text": "渊户"
    },
    {
      "key": "T015",
      "text": "世代守在秘境入口旁边的人家"
    },
    {
      "key": "T016",
      "text": "坦克"
    },
    {
      "key": "T017",
      "text": "战士"
    },
    {
      "key": "T018",
      "text": "法师"
    },
    {
      "key": "T019",
      "text": "射手"
    },
    {
      "key": "T020",
      "text": "牧师"
    },
    {
      "key": "T021",
      "text": "灵气一年薄一寸"
    },
    {
      "key": "T022",
      "text": "功法一代厚一函"
    },
    {
      "key": "T023",
      "text": "天地玄黄传了一代又一代"
    },
    {
      "key": "T024",
      "text": "门外旧路断了一年又一年"
    },
    {
      "key": "T025",
      "text": "崖上的人不抬头"
    },
    {
      "key": "T026",
      "text": "说天上从前有航路"
    },
    {
      "key": "T027",
      "text": "从前走到头的说路还在"
    },
    {
      "key": "T028",
      "text": "后来没走到的说路本来就在"
    },
    {
      "key": "T029",
      "text": "听说隙里灵气满"
    },
    {
      "key": "T030",
      "text": "进去的没一个回来改口"
    },
    {
      "key": "T031",
      "text": "独去的人数日子"
    },
    {
      "key": "T032",
      "text": "结伴的人数名字"
    },
    {
      "key": "T033",
      "text": "带得回山里的石"
    },
    {
      "key": "T034",
      "text": "带不回身上的境"
    },
    {
      "key": "T035",
      "text": "渊户世代守着门"
    },
    {
      "key": "T036",
      "text": "先等来的却是收税的人"
    },
    {
      "key": "T037",
      "text": "立仙走旧天城"
    },
    {
      "key": "T038",
      "text": "立魔过焦原"
    },
    {
      "key": "T039",
      "text": "秘境不生灵气"
    },
    {
      "key": "T040",
      "text": "只生收税的人"
    },
    {
      "key": "T041",
      "text": "城里挂的是仙榜"
    },
    {
      "key": "T042",
      "text": "榜下站的是账房"
    },
    {
      "key": "T043",
      "text": "龙巢的门一直开着"
    },
    {
      "key": "T044",
      "text": "没人问里面，只问谁守门"
    },
    {
      "key": "T045",
      "text": "局是假的"
    },
    {
      "key": "T046",
      "text": "脚底下的路是真的"
    },
    {
      "key": "T047",
      "text": "云海年年白，光柱年年落"
    },
    {
      "key": "T048",
      "text": "仰望的人换了几代"
    }
  ]
}
