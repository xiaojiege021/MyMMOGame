{
  "schema": "ui-text/1",
  "group": "UiStatusScreen",
  "source": "client/MMOGame/Assets/HotUpdate/Ui/UiStatusScreen.cs",
  "entries": [
    {
      "key": "T001",
      "text": "请求没发出去，重试一次"
    },
    {
      "key": "T002",
      "text": "账号或口令不对（不区分原因）"
    },
    {
      "key": "T003",
      "text": "暂时连不上，稍后再试"
    },
    {
      "key": "T004",
      "text": "网络不可达"
    },
    {
      "key": "T005",
      "text": "连不上网关"
    },
    {
      "key": "T006",
      "text": "回登录，不弹「口令错」"
    },
    {
      "key": "T007",
      "text": "提交中"
    },
    {
      "key": "T008",
      "text": "按钮置灰，防重复点"
    },
    {
      "key": "T009",
      "text": "禁用"
    },
    {
      "key": "T010",
      "text": "失败"
    },
    {
      "key": "T011",
      "text": "卡片内一行提示，输入保留、不清口令"
    },
    {
      "key": "T012",
      "text": "错误"
    },
    {
      "key": "T013",
      "text": "成功"
    },
    {
      "key": "T014",
      "text": "Toast 一闪而过，不打断当前操作"
    },
    {
      "key": "T015",
      "text": "登录与会话"
    },
    {
      "key": "T016",
      "text": "确认弹窗用在哪些动作"
    },
    {
      "key": "T017",
      "text": "强化转移（覆盖不返还）、解绑、宗门传位、离开副本。文案只陈述结果，不劝诱、不倒计时。"
    },
    {
      "key": "T018",
      "text": "reason 分组（服务端正本）"
    },
    {
      "key": "T019",
      "text": "状态样例"
    },
    {
      "key": "T020",
      "text": "表现层三条红线：不发权威判定、不回传伤害数字、不做动作预测；"
    },
    {
      "key": "T021",
      "text": "动画只按 foreswing_ms 拉伸播放，事件不触发命中或结算。"
    },
    {
      "key": "T022",
      "text": "演示提示"
    },
    {
      "key": "T023",
      "text": "已保存（演示，不写任何数据）"
    },
    {
      "key": "T024",
      "text": "关闭"
    },
    {
      "key": "T025",
      "text": "关闭这一页？"
    },
    {
      "key": "T026",
      "text": "只回到空骨架，不影响任何数值。"
    }
  ]
}
