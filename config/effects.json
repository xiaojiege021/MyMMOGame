      "when": "foreswing",
      "mana_refund_pct": 100,
      "cooldown_ms": 1000,
      "note": "只在前摇窗口内可打断；被打断退回蓝耗、进一条短冷却。数值待定，Q2 实现，别在代码里写死。"
    },
    "hitstun": {
      "source": "skill_table",
      "default_ms": 300,
      "note": "每个技能一条硬直，来自技能表 / 回包；这里只是缺省值。"
    },
    "cc_diminishing": {
      "window_ms": 15000,
