    },
    "stacking": {
      "rules": [
        "refresh",
        "stack",
        "independent"
      ],
      "refresh_on_stack": true,
      "note": "refresh=重置时长、层数不变；stack=加一层到 max_stacks；independent=各算各的时长，需实例号。"
    },
    "dispel": {
      "by_tags": true,
      "note": "按 dispel_tags 命中移除，不按技能编号写死。"
    },
    "immunity": {
      "by_tags": true,
      "note": "按 immunity_tags 判定，命中即整条效果不生效。"
    },
    "cleanse": {
      "by_tags": true,
      "note": "cleanse 类效果按标签移除 debuff / control；只移除，不返还已跳的 DoT / HoT。"
    },
    "pending": true
  },
  "damage": {
    "schema": "damage-pipeline/1",
    "note": "方案 7.2 四段。四段都是乘区；中间保留 double，只在最终四舍五入一次。穿透与抗性是第 4 段的两个子因子，默认 0 时与 7.2 逐字等价。",
    "stages": [
      {
        "id": "base",
        "formula": "(primary * primary_coef + equipment_flat) * (1 + realm_bonus_pct / 10000)",
        "inputs": [
          "classes.json.attack_per_primary",
          "classes.json.equipment_attack",
          "battle_profile.passive_pct_bps"
        ]
      },
      {
        "id": "enhance",
        "formula": "base * (1 + enhance_coef + crystal_flat_attack / base)",
        "inputs": [
          "config/enhance.json",
          "config/crystal.json"
        ]
      },
      {
        "id": "skill",
        "formula": "enhanced * skill_multiplier * counter_coef",
        "inputs": [
          "config/skills.json.damage_multiplier",
          "counter_table"
        ]
      },
      {
        "id": "final",
        "formula": "skill_damage * defense_mitigation * (1 + crit_bonus) * random_factor * (1 - resistance_pct / 100)",
        "inputs": [
          "defense",
          "crit",
          "random",
          "penetration",
          "resistance"
        ]
      }
    ],
    "realm_bonus": {
      "source": "battle_profile.passive_pct_bps",
      "unit": "bps",
      "note": "角色服把 N10 的 passive_pct_bps 放进战斗快照；战斗服不另读境界表，避免两份口径。"
    },
    "defense": {
      "formula": "clamp(1 - effective_def / (effective_def + k), min_pct, 100)",
      "k": 100,
      "min_pct": 10,
      "note": "方案只写「防御减免」没给公式；Q1 补公式，k 与下限待数值卡确认。怪物防御现值 8–40。"
    },
    "crit": {
      "formula": "1 + (roll < rate_pct ? damage_pct : 0) / 100",
      "rate_pct": 0,
      "damage_pct": 50,
      "note": "方案只写 (1 + 暴伤判定)；Q1 展开成暴击率 × 暴伤。默认 0% 暴击，等 B2 / B10 给来源。"
    },
    "random": {
      "min_pct": 95,
      "max_pct": 105,
      "note": "方案写定 0.95~1.05，不是待定值。"
    },
    "penetration": {
      "enabled": true,
      "formula": "effective_def = max(0, defense * (1 - penetration_pct / 100))",
      "default_pct": 0,
      "cap_pct": 100,
      "source": "B10 结晶 / B15 技能",
      "note": "本轮已打开结构；默认 0，等来源与数值落地，Q2 只把乘区接上。"
    },
    "resistance": {
      "enabled": true,
      "formula": "final *= (1 - resistance_pct / 100)",
      "default_pct": 0,
      "cap_pct": 90,
      "types": [
        "physical",
        "metal",
        "wood",
        "water",
        "fire",
        "earth"
      ],
      "source": "B15 元素 / B10 装备",
      "note": "按伤害类型取抗性；当前所有技能按 physical 算，抗性 0。五行表等 B15，不在这里编元素技能。"
    },
    "rounding": "final_round_half_up",
    "boundaries": {
      "rule": "效果与伤害管线只作用在战斗快照上；模板 / 1.3 / 科技在快照生成时已经生效，管线不许改模板属性。",
      "pve": {
        "mode": "full",
        "source": "battle_profile"
      },
      "arena": {
        "mode": "template",
        "source": "config/arena_match.json",
        "defense_default": 0,
        "note": "模板没有防御字段时按 0 处理；不许用真实装备属性覆盖模板。"
      },
      "battlefield": {
        "mode": "power_compress_before_pipeline",
        "source": "config/battlefield.json",
        "note": "同队战力先压缩，压缩后的属性进四段；1.3 不是伤害乘区，这里不抄数字。"
      },
      "siege": {
        "mode": "full_equipment_plus_tech",
        "source": "config/siege.json",
        "note": "装备全额 + 科技乘在属性上，再进四段；不另开城战伤害公式。"
      }
    },
    "pending": true
  },
